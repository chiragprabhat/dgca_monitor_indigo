{
  "name": "dgca-monitoring-api",
  "version": "1.0.0",
  "description": "Monitors the DGCA portal's What's New section and serves the results over a REST API",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "monitor:once": "node src/scripts/monitor-once.js",
    "deployment:schema": "node src/scripts/setup-deployment.js",
    "worker:actions": "node src/scripts/actions-worker.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "axios": "1.20.0",
    "cheerio": "1.0.0-rc.12",
    "cors": "2.8.6",
    "diff": "5.2.2",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "node-cron": "4.6.0",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1"
  }
}
